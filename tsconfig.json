{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    // 🔥 Ensures your custom module declarations (like qrcode.d.ts) are loaded
    "typeRoots": ["./types", "./node_modules/@types"],

    "incremental": true,

    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  "include": [
    "next-env.d.ts",

    // 🔥 Load your custom declarations FIRST
    "types/**/*.d.ts",

    // Then load all TS/TSX files
    "**/*.ts",
    "**/*.tsx",

    // Next.js generated types
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],

  "exclude": ["node_modules"]
}
