{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],

    // Allow JS because Next.js type-validator scans .js paths
    "allowJs": true,

    // Faster builds, avoids noise from .next validator files
    "skipLibCheck": true,

    // Keep strict mode ON
    "strict": true,

    // Next.js handles emitting
    "noEmit": true,

    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",

    // Required for Next.js typed-routes validator
    "resolveJsonModule": true,
    "isolatedModules": true,

    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@/*": ["*"]
    },

    // Ensure custom types load correctly
    "typeRoots": ["./types", "./node_modules/@types"],

    "incremental": true,

    // Next.js plugin
    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",

    // Required so Next.js validator stops throwing missing .js errors
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],

  "exclude": ["node_modules"]
}
