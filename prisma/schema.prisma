enum Pillar {
  STOCK_SANITIZER
  CUSTOMER
  INVESTOR
}

enum UserRole {
  ADMIN
  INVESTOR
  BORROWER
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  username      String?
  passwordHash  String?
  role          String   @default("user")
  walletAddress String?
  xp            Int      @default(0)
  created_at    DateTime @default(now())

  borrowerDocs     BorrowerDoc[]
  positions        Position[]
  auditLogs        AuditLog[]
  audits           Audit[]
  behaviorProfiles BehaviorProfile[]
  behaviorEvents   BehaviorEvent[]
  bluetoothEvents  BluetoothEvent[]
}

model BorrowerDoc {
  id        Int      @id @default(autoincrement())
  userId    Int
  filename  String
  url       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Position {
  id         Int      @id @default(autoincrement())
  investorId Int
  note       String
  amount     Int
  yield      String
  createdAt  DateTime @default(now())

  investor User @relation(fields: [investorId], references: [id])
}

model Check {
  id            String    @id @default(uuid())
  checkNumber   String    @unique // REQUIRED for findUnique
  amount        Int
  memo          String?
  payee         String?
  date          DateTime?
  status        String
  voidReason    String?
  voidedAt      DateTime?
  bankProfileId Int?
  signerId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pdfUrl String?

  bankProfile BankProfile? @relation(fields: [bankProfileId], references: [id])
  signer      Signer?      @relation(fields: [signerId], references: [id])

  fraudFlags FraudFlag[]
  sar        SuspiciousActivityReport[]
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String?
  target    String?
  details   String?
  adminId   Int?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [adminId], references: [id])
}

model Lead {
  id              String           @id @default(uuid())
  name            String
  email           String?
  createdAt       DateTime         @default(now())
  scores          Json?
  contactAttempts ContactAttempt[]
  leadEvents      LeadEvent[]

  behaviorProfiles BehaviorProfile[]
  behaviorEvents   BehaviorEvent[]
}

model LeadEvent {
  id             String   @id @default(uuid())
  leadId         String
  eventType      String
  page           String?
  element        String?
  description    String?
  timestamp      DateTime @default(now())
  responseTimeMs Int?
  lateNight      Boolean?
  metadata       Json?
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
}

model ContactAttempt {
  id        String   @id @default(uuid())
  leadId    String
  timestamp DateTime @default(now())
  notes     String?

  channel String?
  outcome String?

  lead Lead @relation(fields: [leadId], references: [id])
}

model BankProfile {
  id              Int      @id @default(autoincrement())
  bankName        String
  routingNumber   String
  accountNumber   String
  accountType     String?
  signerName      String?
  nextCheckNumber Int      @default(1)
  createdAt       DateTime @default(now())

  signatureImage String?
  signatureUrl   String?

  checks  Check[]
  signers Signer[]
}

model Investor {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investorPotentialScore Int    @default(0)
  investorPotentialBand  String @default("low")

  notes     String?
  behaviors InvestorBehavior[]

  behaviorProfiles BehaviorProfile[]
  behaviorEvents   BehaviorEvent[]
}

model InvestorBehavior {
  id         String   @id @default(uuid())
  investorId String
  timestamp  DateTime @default(now())
  notes      String?

  investor Investor @relation(fields: [investorId], references: [id])
}

model AnchorRecord {
  id         String   @id @default(cuid())
  merkleRoot String
  txHash     String
  createdAt  DateTime @default(now())
}

model Audit {
  id        String   @id @default(uuid())
  action    String
  details   Json
  createdAt DateTime @default(now())

  adminId Int?
  admin   User? @relation(fields: [adminId], references: [id])
}

model FraudFlag {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  reason    String
  message   String
  severity  String // "critical" | "warning" | "info"
  checkId   String
  resolved  Boolean  @default(false)

  check Check @relation(fields: [checkId], references: [id])
}

model PipelineDeal {
  id        String   @id @default(uuid())
  name      String?
  status    String?
  createdAt DateTime @default(now())
}

model SuspiciousActivityReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  description String?
  category    String?
  severity    String?

  flagId String?
  flag   SarFlag? @relation(fields: [flagId], references: [id])

  checkId String?
  check   Check?  @relation(fields: [checkId], references: [id])
}

model SarFlag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  sar  SuspiciousActivityReport[]
}

model Signer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  title          String?
  signatureImage String?
  signatureUrl   String?

  bankProfileId Int
  bankProfile   BankProfile @relation(fields: [bankProfileId], references: [id])

  checks Check[] // Correct relation name
}

model BluetoothEvent {
  id             String   @id @default(cuid())
  deviceId       String?
  name           String
  timestamp      DateTime
  userId         Int?
  sessionId      String?
  fingerprint    String?
  manufacturer   String?
  model          String?
  rssi           Int?
  signalStrength Int?
  metadata       Json?
  createdAt      DateTime @default(now())

  user    User?          @relation(fields: [userId], references: [id])
  session BehaviorEvent? @relation(fields: [sessionId], references: [id])
}

model BehaviorProfile {
  id         String   @id @default(cuid())
  investorId String?
  leadId     String?
  userId     Int?
  pillar     Pillar
  score      Int
  updatedAt  DateTime @updatedAt

  investor Investor? @relation(fields: [investorId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
}

model BehaviorEvent {
  id                 String   @id @default(cuid())
  userId             Int?
  leadId             String?
  investorId         String?
  pillar             Pillar
  page               String
  startedAt          DateTime
  endedAt            DateTime
  impulsivenessScore Int
  timestamp          DateTime @default(now())
  ticker             String?

  user            User?            @relation(fields: [userId], references: [id])
  lead            Lead?            @relation(fields: [leadId], references: [id])
  investor        Investor?        @relation(fields: [investorId], references: [id])
  bluetoothEvents BluetoothEvent[]
}

model BluetoothAlert {
  id        String   @id @default(cuid())
  deviceId  String?
  message   String
  severity  String
  timestamp DateTime @default(now())
}

model StockEvent {
  id             String   @id @default(cuid())
  userId         Int?
  investorId     String?
  leadId         String?
  page           String
  timestamp      DateTime @default(now())
  rssi           Int?
  signalStrength Int?
  metadata       Json?
}
model LLPAGroup {
  id          String       @id @default(cuid())
  name        String
  description String?
  priority    Int          @default(0)
  active      Boolean      @default(true)

  adjustments LLPAAdjustment[]
}

model LLPAAdjustment {
  id          String     @id @default(cuid())
  groupId     String
  name        String
  description String?
  bps         Int        // positive or negative
  active      Boolean    @default(true)

  // core dimensions
  minFico     Int?
  maxFico     Int?
  minLtv      Float?
  maxLtv      Float?
  occupancy   String?    // "owner", "second", "investment"
  propertyType String?   // "SFR", "CONDO", "2-4", etc.
  purpose     String?    // "purchase", "refi", "cashout"
  loanType    String?    // "conv", "fha", "va", "nonqm"
  termMonths  Int?
  state       String?
  firstTimeHomebuyer Boolean?

  // behavior / bluetooth hooks (for later)
  minImpulsivenessScore Int?
  maxImpulsivenessScore Int?
  requiresBluetoothPresence Boolean?

  group LLPAGroup @relation(fields: [groupId], references: [id])
}
