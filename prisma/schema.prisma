datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Pillar {
  STOCK_SANITIZER
  CUSTOMER
  INVESTOR
  BEHAVIOR
  BLUETOOTH
  STOCK
  PRICING
}

enum UserRole {
  ADMIN
  INVESTOR
  BORROWER
}

enum InvestorAction {
  QUOTE_REQUEST
  LOGIN
  VIEWED_DASHBOARD
}

// ------------------------------------------------------------
// USER + AUTH DOMAIN
// ------------------------------------------------------------

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  username      String?
  phone         String?
  passwordHash  String?
  role          String   @default("user")
  walletAddress String?
  ownerId       String?
  xp            Int      @default(0)
  createdAt     DateTime @default(now())

  positions                Position[]
  auditLogs                AuditLog[]
  audits                   Audit[]
  behaviorProfiles         BehaviorProfile[]
  behaviorEvents           BehaviorEvent[]
  bluetoothEvents          BluetoothEvent[]
  investors                Investor[]
  leads                    Lead[]
  fraudScores              FraudScore[]
  FraudPipeline            FraudPipeline[]
  FraudSignal              FraudSignal[]
  FraudCaseHistory         FraudCaseHistory[]
  FraudFlag                FraudFlag[]
  SuspiciousActivityReport SuspiciousActivityReport[]
  BehavioralScoringLayer   BehavioralScoringLayer[]
  BehavioralTrendAnalytics BehavioralTrendAnalytics[]
}

// ------------------------------------------------------------
// BORROWER DOMAIN
// ------------------------------------------------------------

model Borrower {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  employer String?
  email    String  @unique
  fullName String
  phone    String?
  userId   String?

  applications                Application[]
  BorrowerBehavioralRiskLayer BorrowerBehavioralRiskLayer[]
  BorrowerBehavioralDrift     BorrowerBehavioralDrift[]
  BorrowerRepaymentResilience BorrowerRepaymentResilience[]
  BorrowerRetentionAnalytics  BorrowerRetentionAnalytics[]
  BorrowerHardshipAnalytics   BorrowerHardshipAnalytics[]
  BorrowerFinancialStability  BorrowerFinancialStability[]
  BorrowerFinancialDrift      BorrowerFinancialDrift[]
  BorrowerMacroRiskExposure   BorrowerMacroRiskExposure[]
}

// ------------------------------------------------------------
// INVESTOR DOMAIN
// ------------------------------------------------------------

model Investor {
  id     String  @id @default(cuid())
  name   String
  email  String?
  phone  String?
  userId Int?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investorPotentialScore Int    @default(0)
  investorPotentialBand  String @default("low")

  notes                            String?
  behaviors                        InvestorBehavior[]
  behaviorProfiles                 BehaviorProfile[]
  behaviorEvents                   BehaviorEvent[]
  scoringResults                   InvestorScoringResult[]
  InvestorLiquidity                InvestorLiquidity[]
  InvestorPerformanceSnapshot      InvestorPerformanceSnapshot[]
  InvestorRiskBandHistory          InvestorRiskBandHistory[]
  InvestorCapitalFlow              InvestorCapitalFlow[]
  InvestorAllocationDynamics       InvestorAllocationDynamics[]
  InvestorDiversificationAnalytics InvestorDiversificationAnalytics[]
}

// Investor Behavior
model InvestorBehavior {
  id         String   @id @default(uuid())
  investorId String
  timestamp  DateTime @default(now())
  notes      String?
  action     String
  metadata   Json?

  investor Investor @relation(fields: [investorId], references: [id])
}

// ------------------------------------------------------------
// LEADS
// ------------------------------------------------------------

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String?
  createdAt DateTime @default(now())
  scores    Json?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])

  contactAttempts  ContactAttempt[]
  leadEvents       LeadEvent[]
  behaviorProfiles BehaviorProfile[]
  behaviorEvents   BehaviorEvent[]
  BluetoothEvent   BluetoothEvent[]
}

model LeadEvent {
  id             String   @id @default(uuid())
  leadId         String
  eventType      String
  page           String?
  element        String?
  description    String?
  timestamp      DateTime @default(now())
  responseTimeMs Int?
  lateNight      Boolean?
  metadata       Json?
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
}

model ContactAttempt {
  id        String   @id @default(uuid())
  leadId    String
  timestamp DateTime @default(now())
  notes     String?
  channel   String?
  outcome   String?

  lead Lead @relation(fields: [leadId], references: [id])
}

// ------------------------------------------------------------
// AUDIT + LOGGING
// ------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String?
  target    String?
  details   String?
  adminId   Int?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [adminId], references: [id])
}

model Audit {
  id        String   @id @default(uuid())
  action    String
  details   Json
  createdAt DateTime @default(now())

  adminId Int?
  admin   User? @relation(fields: [adminId], references: [id])
}

// ------------------------------------------------------------
// POSITIONS
// ------------------------------------------------------------

model Position {
  id         Int      @id @default(autoincrement())
  investorId Int
  note       String
  amount     Int
  yield      String
  createdAt  DateTime @default(now())

  investor User @relation(fields: [investorId], references: [id])
}

// ------------------------------------------------------------
// ENVIRONMENT READING
// ------------------------------------------------------------

model EnvironmentReading {
  id               String   @id @default(uuid())
  locationId       String
  deviceCount      Int
  bluetoothDensity Int
  timestamp        DateTime
  riskScore        Float
  createdAt        DateTime @default(now())

  age              Int?
  incomeVolatility Float?
  ipReputation     String?
}

// ------------------------------------------------------------
// APPLICATION (Core Loan File)
// ------------------------------------------------------------

model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  borrowerId String
  borrower   Borrower @relation(fields: [borrowerId], references: [id])

  employer           String?
  underwritingStatus String?
  noteRate           Float?
  liquidAssets       Int?

  status        String  @default("draft")
  loanType      String?
  behaviorScore Float?
  fraudScore    Float?
  routingScore  Float?

  propertyAddress   String?
  purchasePrice     Int?
  incomeAnnual      Int?
  assetsLiquid      Int?
  underwritingScore Int?

  incomeMonthly Int?
  debtsMonthly  Int?
  pitiMonthly   Int?
  propertyValue Int?
  loanAmount    Int?
  totalLiens    Int?

  // Relations
  timelineEvents TimelineEvent[]
  timeline       Timeline[]
  documents      Document[]
  disclosures    Disclosure[]
  underwriting   UnderwritingCase?
  fraudEvents    FraudEvent[]
  milestones     ApplicationMilestone[]

  // Analytics / AI / Scoring
  scoringPipelines     ApplicationScoringPipeline[]
  workflowLayers       ApplicationWorkflowAiLayer[]
  aiScoring            ApplicationAiScoring[]
  riskLadders          ApplicationRiskLadder[]
  complianceLadders    ApplicationComplianceLadder[]
  fraudLadders         ApplicationFraudRiskLadder[]
  complianceChains     ApplicationComplianceSignalChain[]
  fraudChains          ApplicationFraudSignalChain[]
  documentCompleteness ApplicationDocumentCompleteness[]

  // Loan Performance
  amortization                 LoanAmortization?
  payoff                       LoanPayoff?
  delinquency                  LoanDelinquency?
  servicingEvents              LoanServicingEvent[]
  FraudAiInferenceLog          FraudAiInferenceLog?
  FraudEscalation              FraudEscalation?
  FraudEscalationPipelineLayer FraudEscalationPipelineLayer?
  FraudAnomalyDetection        FraudAnomalyDetection?
  FraudFeatureStore            FraudFeatureStore?
  FraudCluster                 FraudCluster?
  FraudTrajectoryModel         FraudTrajectoryModel?
  FraudPropagationModel        FraudPropagationModel?
  FraudContagionMapping        FraudContagionMapping?
  FraudTemporalEvolution       FraudTemporalEvolution?
  FraudNetworkMapping          FraudNetworkMapping?
  FraudPatternEvolution        FraudPatternEvolution?
  FraudSignalChain             FraudSignalChain?
  PricingEngineAudit           PricingEngineAudit?
  PricingEngineInferenceLog    PricingEngineInferenceLog?
  PricingComponentScoring      PricingComponentScoring?
  PricingOptimizationLayer     PricingOptimizationLayer?
  PricingSensitivityLayer      PricingSensitivityLayer?
  PricingAnomalyDetection      PricingAnomalyDetection?
  PricingCurveFitting          PricingCurveFitting?
  PricingVolatilityTracking    PricingVolatilityTracking?
  PricingElasticityAnalytics   PricingElasticityAnalytics?
  LoanRestructuringAnalytics   LoanRestructuringAnalytics?
  LoanCovenantTracking         LoanCovenantTracking?
  LoanCovenantStress           LoanCovenantStress?
  LoanPerformanceTrajectory    LoanPerformanceTrajectory?
  LoanRepaymentCurve           LoanRepaymentCurve?
  LoanStressTest               LoanStressTest?
  Check                        Check?
}

// ------------------------------------------------------------
// TIMELINE
// ------------------------------------------------------------

model TimelineEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  message   String?

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  type     String
  metadata Json?
}

model Timeline {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  type      String?
  message   String?
  event     String
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// APPLICATION MILESTONES
// ------------------------------------------------------------

model ApplicationMilestone {
  id            String       @id @default(cuid())
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id])

  milestone String?
  timestamp DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ------------------------------------------------------------
// LOAN SERVICING EVENTS
// ------------------------------------------------------------

model LoanServicingEvent {
  id            String       @id @default(cuid())
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id])

  eventType String?
  payload   Json?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// LOAN AMORTIZATION
// ------------------------------------------------------------

model LoanAmortization {
  id            String       @id @default(cuid())
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id])

  schedule      Json?
  totalInterest Float?
  totalPaid     Float?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ------------------------------------------------------------
// LOAN PAYOFF
// ------------------------------------------------------------

model LoanPayoff {
  id            String       @id @default(cuid())
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id])

  payoffAmount Float?
  payoffDate   DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ------------------------------------------------------------
// LOAN DELINQUENCY
// ------------------------------------------------------------

model LoanDelinquency {
  id            String       @id @default(cuid())
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id])

  daysLate         Int?
  delinquencyLevel String?
  history          Json?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ------------------------------------------------------------
// APPLICATION SCORING PIPELINE
// ------------------------------------------------------------

model ApplicationScoringPipeline {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  pipelineName String?
  layers       Json?
  finalScore   Float?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ------------------------------------------------------------
// APPLICATION WORKFLOW AI LAYER
// ------------------------------------------------------------

model ApplicationWorkflowAiLayer {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  layerName  String?
  inference  Json?
  confidence Float?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ------------------------------------------------------------
// APPLICATION AI SCORING
// ------------------------------------------------------------

model ApplicationAiScoring {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  modelVersion String?
  score        Float?
  features     Json?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ------------------------------------------------------------
// APPLICATION RISK LADDER
// ------------------------------------------------------------

model ApplicationRiskLadder {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  ladder    Json?
  finalRisk Float?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// APPLICATION COMPLIANCE LADDER
// ------------------------------------------------------------

model ApplicationComplianceLadder {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  ladder          Json?
  complianceScore Float?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ------------------------------------------------------------
// APPLICATION FRAUD RISK LADDER
// ------------------------------------------------------------

model ApplicationFraudRiskLadder {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  ladder     Json?
  fraudScore Float?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ------------------------------------------------------------
// APPLICATION COMPLIANCE SIGNAL CHAIN
// ------------------------------------------------------------

model ApplicationComplianceSignalChain {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  chain           Json?
  complianceScore Float?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ------------------------------------------------------------
// APPLICATION FRAUD SIGNAL CHAIN
// ------------------------------------------------------------

model ApplicationFraudSignalChain {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  chain      Json?
  finalScore Float?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ------------------------------------------------------------
// APPLICATION DOCUMENT COMPLETENESS
// ------------------------------------------------------------

model ApplicationDocumentCompleteness {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  completenessScore Float?
  missingItems      Json?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ------------------------------------------------------------
// DOCUMENT (Core)
// ------------------------------------------------------------

model Document {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  type         String
  url          String
  fraudScore   Float?
  fraudSignals Json?
  embedColor   String?

  classifications     DocumentClassification[]
  ocrExtractions      DocumentOcrExtraction[]
  versions            DocumentVersion[]
  lineage             DocumentLineage?
  complianceScore     DocumentComplianceScore?
  semantic            DocumentSemanticExtraction?
  structural          DocumentStructuralAnalysis?
  transformations     DocumentTransformationLog[]
  extractionPipelines DocumentExtractionPipeline[]
  aiLayers            DocumentAiClassificationLayer[]
}

// ------------------------------------------------------------
// DOCUMENT CLASSIFICATION
// ------------------------------------------------------------

model DocumentClassification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  category   String?
  confidence Float?
  metadata   Json?
}

// ------------------------------------------------------------
// DOCUMENT OCR EXTRACTION
// ------------------------------------------------------------

model DocumentOcrExtraction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  text       String?
  fields     Json?
  confidence Float?
  metadata   Json?
}

// ------------------------------------------------------------
// DOCUMENT VERSIONING
// ------------------------------------------------------------

model DocumentVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  version  Int?
  url      String?
  metadata Json?
}

// ------------------------------------------------------------
// DOCUMENT LINEAGE
// ------------------------------------------------------------

model DocumentLineage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  lineage  Json?
  version  Int?
  metadata Json?
}

// ------------------------------------------------------------
// DOCUMENT COMPLIANCE SCORE
// ------------------------------------------------------------

model DocumentComplianceScore {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  score    Float?
  issues   Json?
  metadata Json?
}

// ------------------------------------------------------------
// DOCUMENT SEMANTIC EXTRACTION
// ------------------------------------------------------------

model DocumentSemanticExtraction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  semantics  Json?
  confidence Float?
  metadata   Json?
}

// ------------------------------------------------------------
// DOCUMENT STRUCTURAL ANALYSIS
// ------------------------------------------------------------

model DocumentStructuralAnalysis {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  structure Json?
  anomalies Json?
  metadata  Json?
}

// ------------------------------------------------------------
// DOCUMENT TRANSFORMATION LOG
// ------------------------------------------------------------

model DocumentTransformationLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  transformationType String?
  details            Json?
  metadata           Json?
}

// ------------------------------------------------------------
// DOCUMENT EXTRACTION PIPELINE
// ------------------------------------------------------------

model DocumentExtractionPipeline {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  pipelineName String?
  steps        Json?
  metadata     Json?
}

// ------------------------------------------------------------
// DOCUMENT AI CLASSIFICATION LAYER
// ------------------------------------------------------------

model DocumentAiClassificationLayer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  layerName  String?
  category   String?
  confidence Float?
  metadata   Json?
}

// ------------------------------------------------------------
// DISCLOSURE (Core)
// ------------------------------------------------------------

model Disclosure {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  type    String
  url     String?
  title   String?
  content String?

  complianceRecords  DisclosureCompliance[]
  trackingRecords    DisclosureTracking[]
  auditTrail         DisclosureAuditTrail[]
  snapshots          DisclosureComplianceSnapshot[]
  lifecycle          DisclosureLifecycleAnalytics?
  complianceLayers   DisclosureComplianceLayer[]
  behaviorAnalytics  DisclosureBehaviorAnalytics?
  behaviorTrajectory DisclosureBehaviorTrajectory?
  sentiment          DisclosureSentimentAnalytics?
  engagement         DisclosureEngagementAnalytics?
}

// ------------------------------------------------------------
// DISCLOSURE COMPLIANCE
// ------------------------------------------------------------

model DisclosureCompliance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?     @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  compliant Boolean?
  issues    Json?
  metadata  Json?
}

// ------------------------------------------------------------
// DISCLOSURE TRACKING
// ------------------------------------------------------------

model DisclosureTracking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?     @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  viewedAt   DateTime?
  acceptedAt DateTime?
  metadata   Json?
}

// ------------------------------------------------------------
// DISCLOSURE AUDIT TRAIL
// ------------------------------------------------------------

model DisclosureAuditTrail {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?     @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  eventType String?
  timestamp DateTime?
  metadata  Json?
}

// ------------------------------------------------------------
// DISCLOSURE COMPLIANCE SNAPSHOT
// ------------------------------------------------------------

model DisclosureComplianceSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?     @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  compliant Boolean?
  issues    Json?
  metadata  Json?
}

// ------------------------------------------------------------
// DISCLOSURE LIFECYCLE ANALYTICS
// ------------------------------------------------------------

model DisclosureLifecycleAnalytics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?     @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  lifecycleStage String?
  metrics        Json?
  metadata       Json?
}

// ------------------------------------------------------------
// DISCLOSURE COMPLIANCE LAYER
// ------------------------------------------------------------

model DisclosureComplianceLayer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?     @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  layerName       String?
  complianceScore Float?
  issues          Json?
  metadata        Json?
}

// ------------------------------------------------------------
// DISCLOSURE BEHAVIOR ANALYTICS
// ------------------------------------------------------------

model DisclosureBehaviorAnalytics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?     @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  behaviorScore Float?
  patterns      Json?
  metadata      Json?
}

// ------------------------------------------------------------
// DISCLOSURE BEHAVIOR TRAJECTORY
// ------------------------------------------------------------

model DisclosureBehaviorTrajectory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?     @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  trajectory    Json?
  behaviorScore Float?
  metadata      Json?
}

// ------------------------------------------------------------
// DISCLOSURE SENTIMENT ANALYTICS
// ------------------------------------------------------------

model DisclosureSentimentAnalytics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?     @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  sentiment String?
  score     Float?
  metadata  Json?
}

// ------------------------------------------------------------
// DISCLOSURE ENGAGEMENT ANALYTICS
// ------------------------------------------------------------

model DisclosureEngagementAnalytics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?     @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  engagementScore Float?
  interactions    Json?
  metadata        Json?
}

// ------------------------------------------------------------
// UNDERWRITING CASE (Master Underwriting File)
// ------------------------------------------------------------

model UnderwritingCase {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  dti              Float?
  ltv              Float?
  cltv             Float?
  reservesMonths   Float?
  riskScore        Float?
  fraudScore       Float?
  investorDecision String?
  llpa             Float?
  finalRate        Float?
  reasons          Json?
  investorReasons  Json?
  status           String
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  underwritingEvents UnderwritingEvent[]
  steps              UnderwritingStep[]
  decisions          UnderwritingDecision[]
  rules              UnderwritingRule[]
  ruleEvaluations    UnderwritingRuleEvaluation[]
  automations        UnderwritingAutomation[]
  exceptions         UnderwritingExceptionLog[]
  escalations        UnderwritingExceptionEscalation[]
  snapshots          UnderwritingSnapshot[]
  aiDecisions        UnderwritingAiDecisionLog[]
  ruleChains         UnderwritingRuleChain[]
  chainAnalytics     UnderwritingChainAnalytics[]
  overrides          UnderwritingOverrideLog[]
  probabilistic      UnderwritingProbabilisticScoring?
  decisionTree       UnderwritingDecisionTree?
  calibrationLogs    UnderwritingCalibrationLog[]
}

// ------------------------------------------------------------
// UNDERWRITING EVENT
