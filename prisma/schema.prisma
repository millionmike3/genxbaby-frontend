datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  username      String?
  passwordHash  String?
  role          String   @default("user")
  walletAddress String?
  xp            Int      @default(0)
  created_at    DateTime @default(now())

  borrowerDocs BorrowerDoc[]
  positions    Position[]
  auditLogs    AuditLog[]
  audits       Audit[]
}

model BorrowerDoc {
  id        Int      @id @default(autoincrement())
  userId    Int
  filename  String
  url       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Position {
  id         Int      @id @default(autoincrement())
  investorId Int
  note       String
  amount     Int
  yield      String
  createdAt  DateTime @default(now())

  investor User @relation(fields: [investorId], references: [id])
}

model Check {
  id            String    @id @default(uuid())
  checkNumber   String    @unique // REQUIRED for findUnique
  amount        Int
  memo          String?
  payee         String?
  date          DateTime?
  status        String
  voidReason    String?
  voidedAt      DateTime?
  bankProfileId Int?
  signerId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pdfUrl String?

  bankProfile BankProfile? @relation(fields: [bankProfileId], references: [id])
  signer      Signer?      @relation(fields: [signerId], references: [id])

  fraudFlags FraudFlag[]
  sar        SuspiciousActivityReport[]
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String?
  target    String?
  details   String?
  adminId   Int?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [adminId], references: [id])
}

model Lead {
  id              String           @id @default(uuid())
  name            String
  email           String?
  createdAt       DateTime         @default(now())
  scores          Json? // <--- Add this
  contactAttempts ContactAttempt[]
  leadEvents      LeadEvent[] // <-- REQUIRED opposite relation
}

model LeadEvent {
  id             String   @id @default(uuid())
  leadId         String
  eventType      String
  page           String?
  element        String?
  description    String?
  timestamp      DateTime @default(now())
  responseTimeMs Int?
  lateNight      Boolean?
  metadata       Json?
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
}

model ContactAttempt {
  id        String   @id @default(uuid())
  leadId    String
  timestamp DateTime @default(now())
  notes     String?

  channel String?
  outcome String?

  lead Lead @relation(fields: [leadId], references: [id])
}

model BankProfile {
  id              Int      @id @default(autoincrement())
  bankName        String
  routingNumber   String
  accountNumber   String
  accountType     String?
  signerName      String?
  nextCheckNumber Int      @default(1)
  createdAt       DateTime @default(now())

  signatureImage String?
  signatureUrl   String?

  checks  Check[]
  signers Signer[]
}

model Investor {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investorPotentialScore Int    @default(0)
  investorPotentialBand  String @default("low")

  notes     String? // <-- ADD THIS
  // 🔥 ADD THIS — opposite side of the relation
  behaviors InvestorBehavior[]
}

model InvestorBehavior {
  id         String   @id @default(uuid())
  investorId String
  timestamp  DateTime @default(now())
  notes      String?

  investor Investor @relation(fields: [investorId], references: [id])
}

model AnchorRecord {
  id         String   @id @default(cuid())
  merkleRoot String
  txHash     String
  createdAt  DateTime @default(now())
}

model Audit {
  id        String   @id @default(uuid())
  action    String
  details   Json
  createdAt DateTime @default(now())

  adminId Int?
  admin   User? @relation(fields: [adminId], references: [id])
}

model FraudFlag {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  reason    String
  message   String
  severity  String // "critical" | "warning" | "info"
  checkId   String
  resolved  Boolean  @default(false)

  check Check @relation(fields: [checkId], references: [id])
}

model PipelineDeal {
  id        String   @id @default(uuid())
  name      String?
  status    String?
  createdAt DateTime @default(now())
}

model SuspiciousActivityReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  description String?
  category    String?
  severity    String?

  flagId String?
  flag   SarFlag? @relation(fields: [flagId], references: [id])

  checkId String?
  check   Check?  @relation(fields: [checkId], references: [id])
}

model SarFlag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  sar  SuspiciousActivityReport[]
}

model Signer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  title          String?
  signatureImage String?
  signatureUrl   String?

  bankProfileId Int
  bankProfile   BankProfile @relation(fields: [bankProfileId], references: [id])

  checks Check[] // Correct relation name
}
