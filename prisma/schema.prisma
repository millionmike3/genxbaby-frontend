// ------------------------------------------------------------
// CHECK (Physical or Digital Check)
// ------------------------------------------------------------

model Check {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id])

  bankProfileId String?
  bankProfile   BankProfile? @relation(fields: [bankProfileId], references: [id])

  amount        Float?
  checkNumber   String?
  routingNumber String?
  accountNumber String?
  metadata      Json?

  signerId String?
  signer   Signer? @relation(fields: [signerId], references: [id])
}

// ------------------------------------------------------------
// BANK PROFILE (Bank Metadata + Risk Signals)
// ------------------------------------------------------------

model BankProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  name          String?
  routingNumber String?
  riskScore     Float?
  metadata      Json?

  checks  Check[]
  signers Signer[]
}

// ------------------------------------------------------------
// SIGNER (Authorized Signer for Checks / Accounts)
// ------------------------------------------------------------

model Signer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String?
  signatureUrl String?
  metadata     Json?

  bankProfileId String?
  bankProfile   BankProfile? @relation(fields: [bankProfileId], references: [id])

  checks Check[]
}
